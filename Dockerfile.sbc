# Dedicated image for ONLY the SBC worker (futbin_sbc_sync.py). Other
# Railway services in this repo keep using Nixpacks/Procfile - this file is
# not the repo-root Dockerfile and must not be picked up by them; the SBC
# Railway service selects it explicitly via RAILWAY_DOCKERFILE_PATH (see
# README's "Railway SBC Worker" section).
#
# FUTBIN's Cloudflare returned HTTP 403 for headless Playwright Chromium but
# HTTP 200 for the same request under headed Chrome in local testing, so this
# worker must run headed, which needs a real X display - hence Xvfb.
FROM mcr.microsoft.com/playwright/python:v1.61.0-noble

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PIP_NO_CACHE_DIR=1
ENV DISPLAY=:99

WORKDIR /app

COPY requirements.txt /app/requirements.txt

RUN python -m pip install \
    --no-cache-dir \
    --upgrade pip \
    && python -m pip install \
    --no-cache-dir \
    -r /app/requirements.txt

# Belt-and-suspenders: the official Playwright Python image already ships
# Chromium plus its Linux system deps (including, in every version checked
# at the time this was written, Xvfb) - not reinstalled here per the
# instruction not to duplicate what the base image already provides.
# These are intentionally NOT hard build failures if either binary is ever
# missing, so a base-image change surfaces as a clear runtime log line
# instead of a silent, confusing worker crash.
RUN command -v Xvfb > /dev/null 2>&1 \
    && echo "Xvfb present in base image" \
    || echo "WARNING: Xvfb not found in base image - worker will fail at runtime"

COPY . /app

# chmod runs AFTER the full COPY, not before - relying on git to preserve
# the executable bit through clone/checkout is fragile; this guarantees it
# regardless.
RUN chmod +x /app/docker-entrypoint-sbc.sh

# A first real deploy hung indefinitely at container start with `xvfb-run
# -a ...` as the CMD - not even this worker's own first log line ever
# appeared, meaning Python never started. xvfb-run's own auto display-
# number selection (scanning /tmp/.X*-lock files) is a known hang point on
# restricted/ephemeral container runtimes. docker-entrypoint-sbc.sh starts
# Xvfb directly on the fixed DISPLAY set above, with its own bounded (~2s)
# readiness check, avoiding xvfb-run's auto-detection entirely.
CMD ["/app/docker-entrypoint-sbc.sh"]
